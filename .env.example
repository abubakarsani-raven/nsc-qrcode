# Railway Postgres (use the public URL, or private if app is also on Railway)
# Prefer appending ?sslmode=require for Railway public URLs.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway?sslmode=require"
# Force SSL in the pg pool even if the URL omits sslmode:
# PGSSL=1

# Auth.js / NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Production site URL (Vercel domain or custom). Keep host short for QR budget.
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Photos — on Vercel the filesystem is ephemeral; prefer a mounted volume / object store later.
PHOTO_STORAGE_DIR="./storage/photos"

# Seeded admin (created during `npm run build` / `db:setup`)
ADMIN_EMAIL="admin@shipperscouncil.gov.ng"
ADMIN_PASSWORD="ChangeMeAdmin1!"

# Set to 1 to skip seed after schema push
# SKIP_DB_SEED=1
