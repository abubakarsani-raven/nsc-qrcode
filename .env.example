# Railway Postgres (use the public URL, or private if app is also on Railway)
# Prefer appending ?sslmode=require for Railway public URLs.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway?sslmode=require"
# Force SSL in the pg pool even if the URL omits sslmode:
# PGSSL=1

# Auth.js / NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Production site URL (Vercel domain or custom). Keep host short for QR budget.
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Photos — REQUIRED in production.
# Vercel's filesystem is read-only outside /tmp and is discarded between
# invocations, so local-disk storage silently loses every uploaded photo.
# When these are set, photos go to Cloudinary as `authenticated` (private)
# assets and are streamed back through the auth-gated /api/photos route.
# Either supply the single URL form:
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# ...or the split form:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Optional media-library folder (default: nsc-id-photos)
# CLOUDINARY_FOLDER="nsc-id-photos"

# Local-disk fallback, used only when Cloudinary is not configured (dev only).
PHOTO_STORAGE_DIR="./storage/photos"

# Seeded admin (created during `npm run build` / `db:setup`)
ADMIN_EMAIL="admin@shipperscouncil.gov.ng"
ADMIN_PASSWORD="ChangeMeAdmin1!"

# Set to 1 to skip seed after schema push
# SKIP_DB_SEED=1
