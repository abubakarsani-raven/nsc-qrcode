# Railway Postgres (use the public URL, or private if app is also on Railway)
# Prefer appending ?sslmode=require for Railway public URLs.
DATABASE_URL="postgresql://postgres:PASSWORD@HOST:PORT/railway?sslmode=require"
# Force SSL in the pg pool even if the URL omits sslmode:
# PGSSL=1

# Auth.js / NextAuth
AUTH_SECRET="generate-with: openssl rand -base64 32"
# Production site URL (Vercel domain or custom). Keep host short for QR budget.
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Photos — REQUIRED in production.
# Two production constraints make Cloudinary mandatory here:
#   1. Vercel's filesystem is read-only outside /tmp and is discarded between
#      invocations, so local-disk storage silently loses every uploaded photo.
#   2. Vercel rejects request bodies over 4.5 MB (HTTP 413), which a
#      print-resolution portrait exceeds. Originals are therefore uploaded
#      from the browser straight to Cloudinary, signed by /api/photos/sign.
# NOTE: delivery is PUBLIC (type: upload) by product decision — anyone with a
# photo URL can view it without signing in.
# Either supply the single URL form:
CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@CLOUD_NAME"
# ...or the split form:
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# Optional media-library folder (default: nsc-id-photos)
# CLOUDINARY_FOLDER="nsc-id-photos"

# Local-disk fallback, used only when Cloudinary is not configured (dev only).
PHOTO_STORAGE_DIR="./storage/photos"

# Seeded admin (created during `npm run build` / `db:setup`)
ADMIN_EMAIL="admin@shipperscouncil.gov.ng"
ADMIN_PASSWORD="ChangeMeAdmin1!"

# The seed only CREATES the admin; it never overwrites an existing password.
# Set ADMIN_PASSWORD_RESET=1 for one deploy to force ADMIN_PASSWORD onto it.
# ADMIN_PASSWORD_RESET=1
# Demo entry/approver/printer accounts are seeded outside production only.
# SEED_DEMO=1

# Set to 1 to skip seed after schema push
# SKIP_DB_SEED=1
